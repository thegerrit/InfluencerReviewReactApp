{
  "name": "influencerreview",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:test": "tsc -b && vite build --mode test",
    "build:prod": "tsc -b && vite build --mode prod",
    "lint": "eslint .",
    "preview": "vite preview",
    "buildwatch": "tsc -b && vite build --watch",
    "start": "node index.js",
    "serve": "npx functions-framework --target=serveViteApp [--signature-type=http] --port=3000",
    "deploy:test": "npm run build:test && gcloud functions deploy InfluencerReviewAppTest --runtime=nodejs18 --region=us-east4 --trigger-http --allow-unauthenticated --entry-point=serveViteApp --source=.",
    "deploy:prod": "npm run build:prod && gcloud functions deploy InfluencerReviewApp--gen2 --runtime=nodejs18 --region=us-east4 --trigger-http --allow-unauthenticated --entry-point=serveViteApp --source=."
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^3.4.2",
    "bootstrap": "^5.3.3",
    "dotenv": "^16.4.7",
    "express": "^4.19.2",
    "firebase": "^11.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/bootstrap": "^5.2.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10"
  }
}
