{
  "name": "influencerreview",
  "private": true,
  "version": "1.0.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:test": "tsc -b && vite build --mode test",
    "build:prod": "tsc -b && vite build --mode prod",
    "lint": "eslint .",
    "preview": "vite preview",
    "buildwatch": "tsc -b && vite build --watch",
    "start": "node index.js",
    "serve": "npx functions-framework --target=serveViteApp [--signature-type=http] --port=3000",
    "deploy:test": "npm run build:test && gcloud functions deploy InfluencerReviewAppTest --runtime=nodejs22 --region=us-east4 --trigger-http --allow-unauthenticated --entry-point=serveViteApp --source=.",
    "deploy:prod": "npm run build:prod && gcloud functions deploy InfluencerReviewApp--gen2 --runtime=nodejs22 --region=us-east4 --trigger-http --allow-unauthenticated --entry-point=serveViteApp --source=."
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^3.4.5",
    "bootstrap": "^5.3.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase": "^11.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/bootstrap": "^5.2.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.20.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.1.1"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
